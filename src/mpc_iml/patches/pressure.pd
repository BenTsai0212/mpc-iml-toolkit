#N canvas 40 40 1040 700 12;
#X text 20 10 mpc-iml-toolkit preset pressure: front end for the engine (python -m mpc_iml.engine <folder> --preset pressure). Sends control messages to UDP 6450 \, shows replies from 6451 and /wek/outputs from 12000. Pd vanilla 0.54 \, no externals.;
#X obj 20 70 loadbang;
#X obj 20 100 t b b b;
#X msg 200 130 connect 127.0.0.1 6450;
#X obj 200 580 list prepend send;
#X obj 200 610 list trim;
#X obj 200 640 netsend -u -b;
#X obj 20 150 bng 25 250 50 0 empty empty hello 30 12 0 12 #fcfcfc #000000 #000000;
#X msg 20 185 1;
#X obj 20 215 oscformat mpciml hello;
#X msg 110 150 symbol pressure;
#X obj 110 250 oscformat mpciml preset load;
